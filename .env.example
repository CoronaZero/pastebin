# Pastebin 环境变量示例。
# 复制为 .env（该文件不会被提交），生产环境通过 systemd EnvironmentFile 或容器环境变量注入。
# 运营者日常可调参数（频率限额、密码尝试上限、IP 封禁等）请登录 Django Admin 后台修改，无需重启。

# 必填（生产）：随机密钥，用于签名会话与 CSRF token。
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(64))"
PASTE_SECRET_KEY=change-me

# 调试模式。生产环境必须为 false。
PASTE_DEBUG=false

# 允许的主机名，逗号分隔。生产环境必填，例如 paste.example.com
PASTE_ALLOWED_HOSTS=paste.example.com

# 可信反向代理跳数，定义客户端真实 IP 的获取方式：
#   0 = 不信任任何 X-Forwarded-For 头，直接使用 TCP 连接对端地址（默认，本地开发安全）；
#   1 = 前置一层可信代理（如 Nginx）时，取 X-Forwarded-For 最右侧第 1 个地址；
#   2 = 前置两层可信代理时，取最右侧第 2 个地址，依此类推。
# 未经可信代理的请求伪造的代理头会被忽略。
PASTE_PROXY_HOPS=1

# SQLite 数据库文件路径（默认 ./db.sqlite3）。可指向绝对路径以便持久化卷挂载。
PASTE_DB_PATH=

# HTTPS 相关（生产建议均为 true）：
# 强制将 http 请求重定向到 https
PASTE_SECURE_SSL_REDIRECT=true
# 会话与 CSRF Cookie 仅通过 HTTPS 传输
PASTE_SECURE_COOKIES=true
